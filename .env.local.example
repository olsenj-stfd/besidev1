# Optional. Set to enable AI features (theme suggestions, moderator triage, resonance matching).
# When unset, the app runs fully without Claude — AI features no-op gracefully.
ANTHROPIC_API_KEY=

# Optional. Defaults to "beside-mod" if unset.
MOD_PASSWORD=

# Supabase. Required for Vercel / production deploy.
# Get these from your Supabase project dashboard → Project Settings → API.
# - SUPABASE_URL: the project URL (https://xxx.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: the service_role key (NOT the anon key — this
#   is server-only and bypasses RLS; never expose to the browser)
#
# If both are absent, the app falls back to a local JSON store at ./.data/store.json
# (works in `npm run dev` only — Vercel's filesystem is read-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
